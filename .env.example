# ── Server ────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/sajawal_bot
REDIS_URL=redis://localhost:6379

# ── WhatsApp Cloud API ────────────────────────────────────
# From developers.facebook.com → your app → WhatsApp → API Setup
GRAPH_VERSION=v23.0
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
# Permanent System User token (NOT the 24h temporary token)
WA_ACCESS_TOKEN=
# App Dashboard → Settings → Basic → App Secret (for webhook signature verification)
WA_APP_SECRET=
# Any random string — you enter the same value in the webhook config UI
WA_WEBHOOK_VERIFY_TOKEN=

# ── Meta Conversions API ──────────────────────────────────
# Events Manager → your school pixel/dataset → dataset ID
META_DATASET_ID=
# Leave blank to reuse WA_ACCESS_TOKEN (works if the system user has the dataset assigned)
META_CAPI_ACCESS_TOKEN=
# From Events Manager → Test events tab. Set while testing, REMOVE in production.
META_TEST_EVENT_CODE=

# ── Claude ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ── Payment verification ──────────────────────────────────
# Your existing website OCR service endpoint. If unset, Claude vision is used alone.
OCR_VERIFY_URL=
OCR_API_KEY=
# Exact PKR amounts that count as a valid payment
VALID_AMOUNTS=3900,8700
# Bank details the bot sends when a buyer is ready. Use \n for line breaks.
BANK_DETAILS="Account Title: ...\nBank: ...\nAccount / IBAN: ...\nAmount: Rs 3,900 (Course A) / Rs 8,700 (Course B)"

# ── Follow-ups ────────────────────────────────────────────
FOLLOWUP_FIRST_DELAY_MS=14400000
FOLLOWUP_TEMPLATE_NAME=course_followup
FOLLOWUP_TEMPLATE_LANG=en
FOLLOWUP_MAX_TOUCHES=2

# ── Website lead import ───────────────────────────────────
# Shared secret your website backend uses to call POST /leads
LEADS_API_KEY=
LEAD_OPENER_TEMPLATE_NAME=website_lead_opener
LEAD_OPENER_TEMPLATE_LANG=en

# ── Ops ───────────────────────────────────────────────────
# WhatsApp number (e.g. 9230xxxxxxxxx) to alert on human handoffs. Optional.
OPS_ALERT_NUMBER=
